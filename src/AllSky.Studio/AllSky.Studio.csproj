<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AllSky.Studio</RootNamespace>
    <AssemblyName>AllSky.Studio</AssemblyName>
  </PropertyGroup>

  <!-- Nessuna dipendenza NuGet: JSON e processi sono del framework.
       Archive: sorgente "notte dell'archivio". Timelapse: solo per localizzare ffmpeg (stesse regole di licenza).
       Products: keogram e startrails per le serie (Products non riferisce Studio: nessun ciclo). -->
  <ItemGroup>
    <ProjectReference Include="..\AllSky.Archive\AllSky.Archive.csproj" />
    <ProjectReference Include="..\AllSky.Timelapse\AllSky.Timelapse.csproj" />
    <ProjectReference Include="..\AllSky.Products\AllSky.Products.csproj" />
    <!-- Export: titoli e descrizioni con il motore di modelli di YouTube, limiti e validazione di Telegram. Nessun NuGet. -->
    <ProjectReference Include="..\AllSky.YouTube\AllSky.YouTube.csproj" />
    <ProjectReference Include="..\AllSky.Telegram\AllSky.Telegram.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AllSky.Studio.Tests" />
  </ItemGroup>

</Project>
