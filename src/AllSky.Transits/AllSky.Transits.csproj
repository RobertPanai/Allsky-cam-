<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AllSky.Transits</RootNamespace>
    <AssemblyName>AllSky.Transits</AssemblyName>
  </PropertyGroup>

  <!-- Logica pura: proiezione dei passaggi nei pixel e conferma del transito sui frame.
       Nessuna dipendenza NuGet. Il riferimento a Detection serve per LumaFrame e per l'interfaccia delle tracce previste. -->
  <ItemGroup>
    <ProjectReference Include="..\AllSky.Satellites\AllSky.Satellites.csproj" />
    <ProjectReference Include="..\AllSky.Sky\AllSky.Sky.csproj" />
    <ProjectReference Include="..\AllSky.Detection\AllSky.Detection.csproj" />
  </ItemGroup>

</Project>
