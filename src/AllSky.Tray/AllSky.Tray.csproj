<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AllSky.Tray</RootNamespace>
    <AssemblyName>AllSkyBrain</AssemblyName>
    <Product>All Sky Brain</Product>
    <AssemblyTitle>All Sky Brain</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllSky.Host\AllSky.Host.csproj" />
    <ProjectReference Include="..\AllSky.Updates\AllSky.Updates.csproj" />
  </ItemGroup>

  <!--
    Aggiornamento automatico (Velopack, licenza MIT). Solo Windows: per questo il riferimento sta nel Tray e non nell'Host.
    TODO: verificare la versione stabile su nuget.org. Dichiarata 1.2.161: ultima stabile letta sulla pagina NuGet
    del pacchetto il 21/10/2026 (1.2.158 risulta deprecata per bug critici).
  -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!--
    Cartella web accanto all'eseguibile. CopyToPublishDirectory copia nel publish (anche single-file,
    dove AppContext.BaseDirectory è la cartella dell'exe, quindi web\ resta accanto ad AllSkyBrain.exe).
    CopyToOutputDirectory serve a far funzionare anche dotnet run / build locale.
    Nessun EmbeddedResource: i file restano leggibili dal disco, come si aspetta il server web.
  -->
  <ItemGroup>
    <None Include="..\..\web\**"
          Exclude="..\..\web\mock\**;..\..\web\_dev\**;..\..\web\_shots\**"
          LinkBase="web"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
